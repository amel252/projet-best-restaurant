
{% extends 'base.html.twig' %}

{% block title %}Connexion | Mon Restaurant{% endblock %}

{% block body %}

<section class="register min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9">
                <div class="card register-card shadow-lg border-0">

                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <h2 class="register-title">
                                Bienvenue parmi nous
                            </h2>
                            <p class="register-subtitle">
                                Connectez-vous pour accéder à votre espace personnel.
                            </p>
                        </div>
                        <form method="post" class="row g-4">
                            {% if error %}
                                <div class="col-12">
                                    <div class="form-errors">
                                        Adresse email ou mot de passe incorrect.
                                    </div>
                                </div>
                            {% endif %}
                            <div class="col-12">
                                <label
                                    for="username"
                                    class="form-label"
                                >
                                    Votre adresse mail
                                </label>
                                <input
                                    type="email"
                                    name="_username"
                                    id="username"
                                    class="form-control custom-input"
                                    value="{{ last_username }}"
                                    placeholder="exemple@email.com"
                                    autocomplete="email"
                                    required
                                >
                            </div>
                            <div class="col-12">
                                <label
                                    for="password"
                                    class="form-label"
                                >
                                    Mot de passe
                                </label>

                                <input
                                    type="password"
                                    name="_password"
                                    id="password"
                                    class="form-control custom-input"
                                    placeholder="Votre mot de passe"
                                    autocomplete="current-password"
                                    required
                                >
                            </div>
                            <div class="col-12">
                                <button
                                    class="btn register-button w-100"
                                    type="submit"
                                >
                                    Se connecter
                                </button>

                            </div>

                            <div class="col-12 text-center">

                                <p class="small paragraphe mb-0">

                                    Vous n'avez pas encore de compte ?

                                    <a
                                        href="{{ path('app_register') }}"
                                        class="login-link"
                                    >
                                        Créer un compte
                                    </a>

                                </p>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

{% endblock %}