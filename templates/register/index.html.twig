{% extends 'base.html.twig' %}

{% block title %}Inscription | Mon Restaurant{% endblock %}

{% block body %}

<section class="register min-vh-100 d-flex align-items-center justify-content-center py-5">

```
<div class="container">

    <div class="row justify-content-center">

        <div class="col-xl-6 col-lg-7 col-md-9">

            <div class="card register-card shadow-lg border-0">

                <div class="card-body p-5">

                    <div class="text-center mb-4">
                        <h2 class="register-title">
                            Créer votre compte
                        </h2>

                        <p class="register-subtitle">
                            Rejoignez notre restaurant et profitez pleinement de votre expérience.
                        </p>
                    </div>

                    <form class="row g-4 needs-validation" novalidate>

                        <div class="col-md-6">
                            <label for="yourName" class="form-label">
                                Votre nom
                            </label>

                            <input
                                type="text"
                                name="name"
                                class="form-control custom-input"
                                id="yourName"
                                placeholder="Votre nom"
                                required
                            >

                            <div class="invalid-feedback">
                                Veuillez insérer votre nom.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label for="yourUsername" class="form-label">
                                Votre prénom
                            </label>

                            <input
                                type="text"
                                name="username"
                                class="form-control custom-input"
                                id="yourUsername"
                                placeholder="Votre prénom"
                                required
                            >

                            <div class="invalid-feedback">
                                Veuillez insérer votre prénom.
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="yourEmail" class="form-label">
                                Votre adresse mail
                            </label>

                            <input
                                type="email"
                                name="email"
                                class="form-control custom-input"
                                id="yourEmail"
                                placeholder="exemple@email.com"
                                required
                            >

                            <div class="invalid-feedback">
                                Veuillez insérer votre adresse mail.
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="yourPassword" class="form-label">
                                Mot de passe
                            </label>

                            <input
                                type="password"
                                name="password"
                                class="form-control custom-input"
                                id="yourPassword"
                                placeholder="Votre mot de passe"
                                required
                            >

                            <div class="invalid-feedback">
                                Merci d'insérer votre mot de passe.
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    name="terms"
                                    type="checkbox"
                                    id="acceptTerms"
                                    required
                                >

                                <label class="form-check-label" for="acceptTerms">
                                    J'accepte les
                                    <a href="#" class="terms-link">
                                        termes et conditions
                                    </a>
                                </label>

                                <div class="invalid-feedback">
                                    Vous devez accepter les conditions.
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <button
                                class="btn register-button w-100"
                                type="submit"
                            >
                                Créer mon compte
                            </button>
                        </div>
                        <div class="col-12 text-center">
                            <p class="small paragraphe mb-0">
                                Vous avez déjà un compte ?
                                <a href="#" class="login-link">
                                    Se connecter
                                </a>
                            </p>
                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

</section>

{% endblock %}
