

{% extends 'base.html.twig' %}

{% block title %}Inscription | Mon Restaurant{% endblock %}

{% block body %}

<section class="register min-vh-100 d-flex align-items-center justify-content-center py-5">


<div class="container">

    <div class="row justify-content-center">

        <div class="col-xl-6 col-lg-7 col-md-9">

            <div class="card register-card shadow-lg border-0">

                <div class="card-body p-5">

                    <div class="text-center mb-4">
                        <h2 class="register-title">
                            Créer votre compte
                        </h2>

                        <p class="register-subtitle">
                            Rejoignez notre restaurant et profitez pleinement de votre expérience.
                        </p>
                    </div>
                    {#  mon formulaire #}

                    {{form_start(registerForm)}}

                    <div class="row g-3">
                        <div class="col-md-6">
                            {{form_label(registerForm.lastName,'Votre nom',{
                                'label_attr':{
                                    'class': 'form-label'
                                }
                            })}}
                            {{ form_widget(registerForm.lastName, {
                                        'attr': {
                                            'class': 'form-control custom-input',
                                            'placeholder': 'Votre nom'
                                        }
                                    }) }}
                            {{ form_errors(registerForm.lastName) }}
                        </div>
                        <div class="col-md-6">
                            {{form_label(registerForm.firstName, 'Votre prénom',{
                                'label_attr': {
                                            'class': 'form-label'
                                        }
                            })}}
                            {{ form_widget(registerForm.firstName, {
                                        'attr': {
                                            'class': 'form-control custom-input',
                                            'placeholder': 'Votre prénom'
                                        }
                                    }) }}

                            {{ form_errors(registerForm.firstName) }}
                        </div>
                    </div>
                        <div class="col-12">
                            {{form_label(registerForm.email,'Votre adresse mail',{
                                'label_attr': {
                                    'class':'form-label'

                                }
                            })}}
                            {{ form_widget(registerForm.email, {
                                    'attr': {
                                        'class': 'form-control custom-input',
                                        'placeholder': 'exemple@email.com'
                                    }
                                }) }}

                            {{ form_errors(registerForm.email) }}
                            
                        </div>

                        <div class="col-12 mb-4">
                            {{form_label(registerForm.password,'Mot de passe',{
                                'label_attr': {
                                            'class': 'form-label'
                                        }
                            })}}
                            {{ form_widget(registerForm.password, {
                                'attr': {
                                    'class': 'form-control custom-input',
                                    'placeholder': 'Votre mot de passe'
                                }
                            }) }}

                            {{ form_errors(registerForm.password) }}

                        </div>

                        <div class="col-12 ">
                            <div class="form-check">
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    required
                                >

                                <label class="form-check-label mb-4" for="acceptTerms">
                                    J'accepte les
                                    <a href="#" class="terms-link">
                                        termes et conditions
                                    </a>
                                </label>
                            </div>
                        </div>

                        <div class="col-12 mb-3">
                            <button
                                class="btn register-button w-100"
                                type="submit"
                            >
                                Créer mon compte
                            </button>
                        </div>

                        <div class="col-12 text-center">
                            <p class="small paragraphe mb-0">
                                Vous avez déjà un compte ?
                                <a href="#" class="login-link">
                                    Se connecter
                                </a>
                            </p>
                        </div>

                    {{form_end(registerForm)}}

                </div>

            </div>

        </div>

    </div>

</div>

</section>

{% endblock %}
