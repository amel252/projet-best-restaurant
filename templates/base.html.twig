<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>
            {% block title %}Best Restaurant{% endblock %}
        </title>

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('vendor/bootstrap/css/bootstrap.min.css') }}">
            <link rel="stylesheet" href="{{ asset('vendor/bootstrap-icons/bootstrap-icons.css') }}">
            <link rel="stylesheet" href="{{ asset('vendor/aos/aos.css') }}">
            <link rel="stylesheet" href="{{ asset('vendor/swiper/swiper-bundle.min.css') }}">
            <link rel="stylesheet" href="{{ asset('css/main.css') }}">
        {% endblock %}
    </head>

    <body>
        {# HEADER #}
        <header id="header" class="header sticky-top">
            <div class="container header-container">

                {# LOGO #}
                <a href="{{ path('app_home') }}" class="logo">
                    <i class="bi bi-fork-knife"></i>
                    <h1>Vite&Gourmand</h1>
                </a>

                {# MENU BURGER MOBILE #}
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>

                {# NAVIGATION #}
                <nav id="navmenu" class="navmenu">
                    <ul>
                        {# LIENS PRINCIPAUX #}
                        <li><a href="{{ path('app_home') }}" class="active">Accueil</a></li>
                        <li><a href="#about">À propos</a></li>
                        <li><a href="#menu">Menu</a></li>
                        <li><a href="#chefs">Chefs</a></li>
                        <li><a href="#events">Événements</a></li>
                        <li><a href="#galerie">Galerie</a></li>
                        <li><a href="#contact">Contact</a></li>

                        {# CONNEXION ET PANIER #}
                        <li class="nav-actions">
                            {# PROFIL UTILISATEUR #}
                            <div class="nav-login">
                                {% if app.user %}
                                    {% if is_granted('ROLE_ADMIN') %}
                                        <a href="{{ path('admin') }}" title="Administration">
                                            <i class="bi bi-person"></i>
                                            <span>{{ app.user.firstname }}</span>
                                        </a>
                                    {% else %}
                                        <a href="{{ path('app_profile') }}" title="Mon profil">
                                            <i class="bi bi-person"></i>
                                            <span>{{ app.user.firstname }}</span>
                                        </a>
                                    {% endif %}
                                {% else %}
                                    <a href="{{ path('app_login') }}"
                                       title="Connexion"
                                       aria-label="Connexion">
                                        <i class="bi bi-person"></i>
                                    </a>
                                {% endif %}
                            </div>

                            {# PANIER #}
                            <a href="{{ path('app_cart') }}"
                               class="cart-icon"
                               title="Mon panier"
                               aria-label="Mon panier">
                                <i class="bi bi-cart"></i>

                                {% if fullCartQuantity > 0 %}
                                    <span class="cart-badge">
                                        {{ fullCartQuantity }}
                                    </span>
                                {% endif %}
                            </a>
                        </li>

                        {# BOUTON RÉSERVER #}
                        <li class="nav-reservation">
                            <a href="#book-a-table" class="link-reservation">
                                Réserver
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </header>

        {# MESSAGES FLASH #}
        <div class="flash-container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Fermer">
                        </button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {# CONTENU DE LA PAGE #}
        {% block body %}{% endblock %}

        {# FOOTER #}
        <footer id="footer" class="footer">
            <div class="container footer-top">
                <div class="row gy-4 align-items-start">

                    {# BLOC 1 : IDENTITÉ ET CONTACT #}
                    <div class="col-lg-5 col-md-6 footer-about ps-2">
                        <a href="{{ path('app_home') }}" class="logo d-flex align-items-center">
                            <span class="sitename">Vite&Gourmand</span>
                        </a>

                        <p class="footer-description">
                            Bienvenue chez Vite&Gourmand, où saveurs,
                            qualité et convivialité se rencontrent pour vous
                            offrir une expérience culinaire inoubliable.
                        </p>

                        <div class="footer-contact-info">
                            <p>
                                <i class="bi bi-geo-alt-fill"></i>
                                <span>108 Avenue des Belges, Paris, 93000 France</span>
                            </p>

                            <p>
                                <i class="bi bi-telephone-fill"></i>
                                <a href="tel:+33624097625">06 24 09 76 25</a>
                            </p>

                            <p>
                                <i class="bi bi-envelope-fill"></i>
                                <a href="mailto:best@live.fr">best@live.fr</a>
                            </p>
                        </div>

                        <div class="social-links d-flex mt-4">
                            <a href="#" aria-label="Twitter">
                                <i class="bi bi-twitter-x"></i>
                            </a>
                            <a href="#" aria-label="Facebook">
                                <i class="bi bi-facebook"></i>
                            </a>
                            <a href="#" aria-label="Instagram">
                                <i class="bi bi-instagram"></i>
                            </a>
                            <a href="#" aria-label="LinkedIn">
                                <i class="bi bi-linkedin"></i>
                            </a>
                        </div>
                    </div>

                    {# BLOC 2 : LIENS UTILES #}
					<div class="col-lg-3 col-md-5 d-none d-md-block footer-links">
                    {# <div class="col-lg-3 col-md-6 footer-links ps-5"> #}
                        <h6>Liens utiles</h6>
                        <ul>
                            <li>
                                <i class="bi bi-chevron-right"></i>
                                <a href="{{ path('app_home') }}">Accueil</a>
                            </li>
                            <li>
                                <i class="bi bi-chevron-right"></i>
                                <a href="{{ path('app_home') }}#about">À propos</a>
                            </li>
                            <li>
                                <i class="bi bi-chevron-right"></i>
                                <a href="{{ path('app_home') }}#menu">Menus</a>
                            </li>
                            <li>
                                <i class="bi bi-chevron-right"></i>
                                <a href="{{ path('app_home') }}#events">Événements</a>
                            </li>
                            <li>
                                <i class="bi bi-chevron-right"></i>
                                <a href="{{ path('app_home') }}#contact">Contact</a>
                            </li>
                        </ul>
                    </div>

                    {# BLOC 3 : HORAIRES D'OUVERTURE #}
                    <div class="col-lg-4 col-md-12 footer-hours footer-links-hour">
                        {% include 'partials/_opening_hours.html.twig' %}
                    </div>

                </div>
            </div>

            {# COPYRIGHT #}
            <div class="container copyright text-center mt-4">
                <p>
                    © <span>Copyright</span>
                    <strong class="px-1 sitename">Vite&Gourmand</strong>
                    <span>Tous droits réservés</span>
                </p>
            </div>
        </footer>

        {# JAVASCRIPTS #}
        {% block javascripts %}
            <script src="{{ asset('vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
            <script src="{{ asset('vendor/aos/aos.js') }}"></script>
            <script src="{{ asset('vendor/swiper/swiper-bundle.min.js') }}"></script>
            <script src="{{ asset('vendor/purecounter/purecounter_vanilla.js') }}"></script>
            <script src="{{ asset('vendor/imagesloaded/imagesloaded.pkgd.min.js') }}"></script>
            <script src="{{ asset('vendor/isotope-layout/isotope.pkgd.min.js') }}"></script>
            <script src="{{ asset('js/main.js') }}"></script>
        {% endblock %}
    </body>
</html>