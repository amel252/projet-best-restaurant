{% extends 'base.html.twig' %}
{% block body %}

<section class="menus-page">
    <div class="container">
        <div class="category-header">
            <h2>Nos menus</h2>
            <p>Découvrez nos menus et choisissez celui qui vous convient.</p>
        </div>

        <div class="menu-layout">
            {# BARRE DES FILTRES #}
            <aside class="menu-filters">
                <h3 class="filters-title">Filtrer les menus</h3>
                <button
                    type="button"
                    class="filters-toggle"
                    aria-expanded="false"
                    aria-controls="menu-filters"
                    onclick="
                        const form = document.getElementById('menu-filters');
                        const expanded = this.getAttribute('aria-expanded') === 'true';
                        this.setAttribute('aria-expanded', String(!expanded));
                        form.classList.toggle('is-open', !expanded);
                    "
                >
                    <span>Filtrer les menus</span>
                    <span class="filters-arrow">⌄</span>
                </button>
                <form id="menu-filters" method="get" action="{{ path('app_menu') }}">
                    <div class="filter-group">
                        <label for="minPrice">Prix minimum (€)</label>
                        <input type="number" id="minPrice"
                               name="minPrice" min="0" step="0.01"
                               value="{{ app.request.query.get('minPrice') }}">
                    </div>
                    <div class="filter-group">
                        <label for="maxPrice">Prix maximum (€)</label>
                        <input type="number" id="maxPrice"
                               name="maxPrice" min="0" step="0.01"
                               value="{{ app.request.query.get('maxPrice') }}">
                    </div>
                    <div class="filter-group">
                        <label for="theme">Thème</label>
                        <select id="theme" name="theme">
                            <option value="">Tous les thèmes</option>
                            <option value="classique" {% if app.request.query.get('theme') == 'classique' %}selected{% endif %}>Classique</option>
                            <option value="noel" {% if app.request.query.get('theme') == 'noel' %}selected{% endif %}>Noël</option>
                            <option value="paques" {% if app.request.query.get('theme') == 'paques' %}selected{% endif %}>Pâques</option>
                            <option value="evenement" {% if app.request.query.get('theme') == 'evenement' %}selected{% endif %}>Évènement</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label for="diet">Régime alimentaire</label>
                        <select id="diet" name="diet">
                            <option value="">Tous les régimes</option>
                            <option value="classique" {% if app.request.query.get('diet') == 'classique' %}selected{% endif %}>Classique</option>
                            <option value="vegetarien" {% if app.request.query.get('diet') == 'vegetarien' %}selected{% endif %}>Végétarien</option>
                            <option value="vegan" {% if app.request.query.get('diet') == 'vegan' %}selected{% endif %}>Vegan</option>
                        </select>
                    </div>

                    <div class="filter-group">
                        <label for="minPeople">Nombre de personnes</label>
                        <input type="number" id="minPeople"
                               name="minPeople" min="1"
                               value="{{ app.request.query.get('minPeople') }}" >
                    </div>
                    <button type="submit" class="product-btn product-btn-primary">
                        Rechercher
                    </button>
                    <a href="{{ path('app_menu') }}" class="product-btn product-btn-outline">
                        Réinitialiser
                    </a>

                </form>
            </aside>
            {# LISTE DES MENUS #}
            <div class="menu-results" id="menu-results">
                {% include 'menu/_results.html.twig' %}
            </div>
        </div>
    </div>
</section>

{% endblock %}
