{% extends 'base.html.twig' %}

{% block title %}
    Modifier mon mot de passe
{% endblock %}

{% block body %}

<section class="profile-page">
    <div class="container">
        <div class="profile-card">
            <div class="profile-card-header">
                <div>
                    <span class="profile-card-subtitle">
                        Sécurité
                    </span>
                    <h2>
                        Modifier mon mot de passe
                    </h2>
                </div>
                <i class="bi bi-shield-lock profile-card-icon"></i>
            </div>
            {{ form_start(modifyPwd) }}
                <div class="profile-form">
                    {{ form_row(modifyPwd.currentPassword) }}
                    {{ form_row(modifyPwd.newPassword.first) }}
                    {{ form_row(modifyPwd.newPassword.second) }}
                </div>
                <div class="profile-actions">
                    <button
                        type="submit"
                        class="profile-button-primary"
                    >
                        <i class="bi bi-check-circle"></i>
                        Enregistrer
                    </button>
                    <a
                        href="{{ path('app_profil') }}"
                        class="profile-button-danger"
                    >
                        <i class="bi bi-arrow-left"></i>
                        Retour
                    </a>
                </div>
            {{ form_end(modifyPwd) }}
        </div>
    </div>
</section>

{% endblock %}