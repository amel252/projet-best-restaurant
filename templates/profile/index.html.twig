
{% extends 'base.html.twig' %}

{% block title %}
    Mon profil - BestRestaurant
{% endblock %}

{% block body %}
<section class="profile-page">
    <div class="container">

        {# TITRE DE LA PAGE #}
        <div class="profile-header">
            <span class="profile-subtitle">
                Mon espace personnel
            </span>
            <h1>Mon profil</h1>
            <p>Gérez vos informations personnelles et votre compte.</p>
        </div>

        {# LES 2 BLOCS #}
        <div class="profile-content">
            {# BLOC GAUCHE : MENU#}
            <div class="profile-card profile-menu">

                <h2 class="profile-menu-title"> Mon compte</h2>
                <div class="profile-menu-links">
                    {# Informations personnelles #}
                    <a
                        href="{{ path('app_profile_edit') }}"
                        class="profile-menu-link"
                    >
                        <i class="bi bi-person"></i>
                        <span>Mes informations</span>
                    </a>
                    {# Adresses #}

                    <a href="{{ path('app_account_address_form')}}" class="profile-menu-link" > 
                        <i class="bi bi-geo-alt"></i> 
                        <span>Mes adresses</span> 
                    </a>

                    {# mot de passe #}
                    <a
                        href="{{ path('app_account_edit_password') }}"
                        class="profile-menu-link"
                    ><i class="bi bi-lock"></i>
                        <span>Modifier mon mot de passe</span>
                    </a>

                    {# Déconnexion #}

                    <a
                        href="{{ path('app_logout') }}"
                        class="profile-menu-link profile-menu-link-danger"
                    >
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Déconnexion</span>
                    </a>
                </div>
            </div>


            {#BLOC DROIT : INFORMATIONS UTILISATEUR #}

            <div class="profile-card profile-information">
                {# PHOTO + IDENTITÉ #}
                <form
                    id="avatarForm"
                    method="post"
                    action="{{ path('app_profile') }}"
                    enctype="multipart/form-data"
                >
                    <div class="profile-user-header">
                        {# PHOTO #}
                        <div class="profile-avatar-wrapper">
                            <label for="profileImage" class="profile-avatar">
                                {% if app.user.profileImage %}
                                    <img
                                        src="{{ asset('uploads/profile/' ~ app.user.profileImage) }}"
                                        alt="Photo de profil"
                                        id="profilePreview"
                                    >
                                {% else %}
                                    <i
                                        class="bi bi-person"
                                        id="profileIcon"
                                    ></i>
                                {% endif %}

                            </label>

                            <input
                                type="file"
                                id="profileImage"
                                name="profileImage"
                                accept="image/*"
                                hidden
                            >

                        </div>
                        {# NOM  #}
                        <div class="profile-user-identity">
                            <h2 class="profile-card-title">
                                {{ app.user.firstName }}
                                {{ app.user.lastName }}
                            </h2>
                        </div>
                    </div>

                </form>

                {# TITRE INFORMATIONS#}
                <div class="profile-information-header">
                    <h2>Mes informations</h2>
                </div>

                {# INFORMATIONS #}
                <div class="profile-info">
                    {# PRÉNOM #}
                    <div class="profile-info-item">
                        <span class="profile-info-label"> Prénom :</span>
                        <span class="profile-info-value">
                            {{ app.user.firstName }}
                        </span>

                    </div>

                    {# NOM #}

                    <div class="profile-info-item">
                        <span class="profile-info-label">Nom :</span>
                        <span class="profile-info-value">
                            {{ app.user.lastName }}
                        </span>
                    </div>

                    {# EMAIL #}
                    <div class="profile-info-item">
                        <span class="profile-info-label">Adresse email :</span>
                        <span class="profile-info-value">
                            {{ app.user.email }}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}

