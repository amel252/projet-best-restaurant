{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié | Vite & Gourmand{% endblock %}

{% block body %}
<section class="register min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9">
                <div class="card register-card shadow-lg border-0">
                    <div class="card-body p-5">

                        <div class="text-center mb-4">
                            <h2 class="register-title">Mot de passe oublié ?</h2>
                            <p class="register-subtitle">
                                Saisissez votre adresse e-mail pour recevoir un lien de réinitialisation de votre mot de passe.
                            </p>
                        </div>

                        {% for flash_error in app.flashes('reset_password_error') %}
                            <div class="form-errors mb-3" role="alert">
                                {{ flash_error }}
                            </div>
                        {% endfor %}

                        {{ form_start(requestForm, {'attr': {'class': 'row g-4'}}) }}

                            <div class="col-12">
                                {{ form_label(requestForm.email, 'Votre adresse mail', {'label_attr': {'class': 'form-label'}}) }}
                                {{ form_widget(requestForm.email, {
                                    'attr': {
                                        'class': 'form-control custom-input',
                                        'placeholder': 'exemple@email.com',
                                        'autocomplete': 'email'
                                    }
                                }) }}
                                {{ form_errors(requestForm.email) }}
                            </div>

                            <div class="col-12">
                                <button class="btn register-button w-100" type="submit">
                                    Envoyer le lien de réinitialisation
                                </button>
                            </div>

                            <div class="col-12 text-center">
                                <a href="{{ path('app_login') }}" class="login-link">
                                    Retour à la connexion
                                </a>
                            </div>

                        {{ form_end(requestForm) }}

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
