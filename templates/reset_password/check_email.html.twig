{% extends 'base.html.twig' %}

{% block title %}Vérification de votre e-mail | Vite & Gourmand{% endblock %}

{% block body %}
<section class="register min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-7 col-md-9">
                <div class="card register-card shadow-lg border-0">
                    <div class="card-body p-5 text-center">

                        <h2 class="register-title mb-4">
                            Vérifiez votre boîte mail
                        </h2>

                        <p class="register-subtitle">
                            Si un compte correspond à votre adresse e-mail,
                            un message contenant un lien de réinitialisation
                            vient de vous être envoyé.
                        </p>

                        <p class="small paragraphe">
                            Ce lien expirera dans
                            {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
                        </p>

                        <p class="small paragraphe">
                            Vous n'avez pas reçu le message ?
                            Pensez à vérifier vos courriers indésirables.
                        </p>

                        <a href="{{ path('app_forgot_password_request') }}"
                           class="login-link">
                            Réessayer
                        </a>

                        <div class="mt-3">
                            <a href="{{ path('app_login') }}" class="login-link">
                                Retour à la connexion
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}