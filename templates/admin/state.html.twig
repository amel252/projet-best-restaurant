{% if field.value == 1 %}
    <span class="badge text-bg-secondary">Acceptée</span>
{% elseif field.value == 2 %}
    <span class="badge text-bg-warning">En préparation</span>
{% elseif field.value == 3 %}
    <span class="badge text-bg-info">En cours de livraison</span>
{% elseif field.value == 4 %}
    <span class="badge text-bg-success">Livrée</span>
{% elseif field.value == 5 %}
    <span class="badge text-bg-warning">En attente du retour de matériel</span>
{% elseif field.value == 6 %}
    <span class="badge text-bg-success">Terminée</span>
{% endif %}